# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=production

# Security: Mandatory JWT secret in production (use a strong random string)
JWT_SECRET=replace_with_a_long_random_secret_string

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-app.onrender.com
# CORS_ORIGIN=https://your-frontend-app.onrender.com,https://your-domain.com

# ------------------------------------------------------------------------------
# Database Configuration Option A: Complete Database Connection URI (Recommended for Cloud)
# e.g., from Railway, Render MySQL, PlanetScale, Aiven, etc.
# ------------------------------------------------------------------------------
# MYSQL_URL=mysql://user:password@host:port/database

# ------------------------------------------------------------------------------
# Database Configuration Option B: Discrete Connection Parameters
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=college
DB_SSL=false

# ------------------------------------------------------------------------------
# Initial Administrator Account (Created automatically by db:init if empty)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@sjcetpalai.ac.in
ADMIN_PASSWORD=ChangeThisStrongPassword2026!

# ------------------------------------------------------------------------------
# Optional Puppeteer Configuration (for PDF report generation in containers)
# ------------------------------------------------------------------------------
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
